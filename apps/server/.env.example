PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/cms
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
TZ_NAME=Asia/Kolkata
SEED_ADMIN_EMAIL=admin@company.local
SEED_ADMIN_PASSWORD=Admin@12345

# Password-reset email. Without SMTP_HOST the reset link is printed in the server log (fine for local dev).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=CMS <no-reply@yourcompany.com>

# Daily 01:00 JSON backup of the whole database (BACKUP_KEEP newest files are kept)
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
